// ============================================================
// JOCKY Forensic Language Grammar
// Version: 0.3.0
// Parser mode: lalr + Indenter post-lexer (for indent/dedent)
//
// Changes from 0.1.x:
//   - function definition blocks (define / endfn)
//   - call command for user-defined functions
//   - if/when conditional blocks
//   - new sections: files, android
//   - new commands: extract, dump, list
//   - new primitives: prefetch_history, event_log, usb_history,
//     browser_history, scheduled_tasks, arp_table, file_tree,
//     proc_memory, loaded_modules, drivers, handles, tokens,
//     shares, named_pipes, sockets, arp_cache, route_table,
//     wifi_profiles, installed_apps, sms, call_log, location,
//     whatsapp_db, telegram_db, contacts
// ============================================================

// ─── Entry Point ─────────────────────────────────────────────────────────────
//
//  A valid JOCKY script is exactly:
//    - optional blank lines / comment lines
//    - optional function definitions (before the case block)
//    - exactly one case block
//    - one or more section blocks
//
//  Functions must be declared before use (forward references not supported).

start: _NL* (_func_item)* case_block section_block+

_func_item: func_def _NL*

// ─── Function Definitions ─────────────────────────────────────────────────────
//
//  define proc_hollowing_check(target_pid)
//      acquire process_list()
//      acquire memory_region(pid=target_pid, size=65536)
//      acquire loaded_modules(pid=target_pid)
//
//  Parameters are positional names — no types, no defaults in v0.3.
//  Functions share the same command/primitive space as top-level sections.

func_def: "define" func_name "(" param_list? ")" _NL _INDENT func_body _DEDENT

func_name: NAME

param_list: param_name ("," param_name)*
param_name: NAME

func_body: func_stmt+

func_stmt: operation
         | cond_block

// ─── Case / Header Block ─────────────────────────────────────────────────────
//
//  case
//      id          "CASE-2026-0417"
//      operator    "J.Sharma"
//      target      "WIN-MACHINE-04"
//      mode        "remote"
//
//  All four fields are mandatory and must appear in this exact order.
//  A missing field fails at parse time — no silent omissions.

case_block: "case" _NL _INDENT id_field operator_field target_field mode_field _DEDENT

id_field:       "id"       STRING _NL
operator_field: "operator" STRING _NL
target_field:   "target"   STRING _NL
mode_field:     "mode"     STRING _NL

// ─── Section Blocks ──────────────────────────────────────────────────────────
//
//  section memory
//      acquire process_list()
//
//  Extended section types: memory, network, system, disk, files, android
//  Volatility order: memory > network > system > disk > files > android
//  (android is always last — off-device collection)

section_block: "section" section_name _NL _INDENT section_stmt+ _DEDENT

section_name: MEMORY | NETWORK | SYSTEM | DISK | FILES | ANDROID

// ─── Section Statements ───────────────────────────────────────────────────────
//
//  A section contains operations, conditional blocks, or function calls.

section_stmt: operation
            | cond_block
            | call_stmt

// ─── Operations ──────────────────────────────────────────────────────────────
//
//  <command> <primitive>(<arglist?>)
//
//  Commands: acquire, inspect, hash, capture, extract, dump, list
//  Primitives: any NAME (validated post-parse by validator.py)

operation: command primitive "(" arglist? ")" _NL?

command: ACQUIRE | INSPECT | HASH | CAPTURE | EXTRACT | DUMP | LIST

primitive: NAME
         | MEMORY | NETWORK | SYSTEM | DISK | FILES | ANDROID
         | ACQUIRE | INSPECT | HASH | CAPTURE | EXTRACT | DUMP | LIST

// ─── Function Call ────────────────────────────────────────────────────────────
//
//  call proc_hollowing_check(pid=1044)
//  call exfil_trace()

call_stmt: "call" func_name "(" call_args? ")" _NL?

call_args: call_arg ("," call_arg)*
call_arg: NAME "=" arg_value

// ─── Conditional Block ────────────────────────────────────────────────────────
//
//  when suspicious > 0
//      inspect registry(key="HKLM\Software\Microsoft\Windows\CurrentVersion\Run")
//      acquire dns_cache()
//
//  Conditions are evaluated at interpreter runtime against the result
//  accumulator. The grammar accepts any expression string — semantic
//  evaluation is the interpreter's responsibility.

cond_block: "when" cond_expr _NL _INDENT cond_body _DEDENT

cond_expr: cond_term (COND_OP cond_term)*

cond_term: NAME ("." NAME)*
         | INTEGER
         | STRING

COND_OP: ">" | "<" | ">=" | "<=" | "==" | "!=" | "and" | "or"

cond_body: section_stmt+

// ─── Arguments ───────────────────────────────────────────────────────────────
//
//  pid=1044, size=4096, path="C:\suspect\invoice.pdf", state=running
//
//  arg_value accepts NAME plus all keyword terminals for the same reason
//  as primitive — an argument value might be a word that is also a keyword.

arglist: argument ("," argument)*

argument: arg_name "=" arg_value

arg_name: NAME

arg_value: STRING
         | INTEGER
         | NAME
         | MEMORY | NETWORK | SYSTEM | DISK | FILES | ANDROID
         | ACQUIRE | INSPECT | HASH | CAPTURE | EXTRACT | DUMP | LIST

// ─── Named keyword terminals ──────────────────────────────────────────────────
//
//  Defined as named terminals so they survive into the parse tree.
//  Priority: string literals > NAME regex (no lexer ambiguity).

// Section names
MEMORY  : "memory"
NETWORK : "network"
SYSTEM  : "system"
DISK    : "disk"
FILES   : "files"
ANDROID : "android"

// Command keywords
ACQUIRE : "acquire"
INSPECT : "inspect"
HASH    : "hash"
CAPTURE : "capture"
EXTRACT : "extract"
DUMP    : "dump"
LIST    : "list"

// ─── Core terminals ───────────────────────────────────────────────────────────

// Double-quoted string — backslashes are literal (Windows paths work correctly).
STRING  : "\"" /[^"]*/ "\""

// Unsigned integer literal.
INTEGER : /[0-9]+/

// Unquoted identifier.
NAME    : /[a-zA-Z_][a-zA-Z0-9_]*/

// ─── Whitespace and structure ─────────────────────────────────────────────────

_NL : /(\r?\n[\t ]*)+/

%declare _INDENT _DEDENT

%ignore /[ \t]+/

// Comments: # to end of line.
%ignore /\#[^\n]*/
