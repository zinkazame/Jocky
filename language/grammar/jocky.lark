// ============================================================
// JOCKY Forensic Language Grammar
// Version: 0.1.2
// Parser mode: lalr + Indenter post-lexer (for indent/dedent)
// ============================================================

// ─── Entry Point ─────────────────────────────────────────────────────────────
//
//  A valid JOCKY script is exactly:
//    - optional blank lines / comment lines
//    - exactly one case block
//    - one or more section blocks
//
//  Section *order* and *uniqueness* are NOT enforced here —
//  they are post-parse validation constraints (see validation_rules.md).

start: _NL* case_block section_block+

// ─── Case / Header Block ─────────────────────────────────────────────────────
//
//  case
//      id          "CASE-2026-0417"
//      operator    "J.Sharma"
//      target      "WIN-MACHINE-04"
//      mode        "remote"
//
//  All four fields are mandatory and must appear in this exact order.
//  A missing field fails at parse time — no silent omissions.

case_block: "case" _NL _INDENT id_field operator_field target_field mode_field _DEDENT

id_field:       "id"       STRING _NL
operator_field: "operator" STRING _NL
target_field:   "target"   STRING _NL
mode_field:     "mode"     STRING _NL

// ─── Section Blocks ──────────────────────────────────────────────────────────
//
//  section memory
//      acquire process_list()
//      acquire memory_region(pid=1044, size=4096)
//
//  section_name uses named terminals (MEMORY, NETWORK, SYSTEM, DISK)
//  so their values appear in the parse tree for Phase 3 validation.

section_block: "section" section_name _NL _INDENT operation+ _DEDENT

section_name: MEMORY | NETWORK | SYSTEM | DISK

// ─── Operations ──────────────────────────────────────────────────────────────
//
//  <command> <primitive>(<arglist?>)
//
//  command uses named terminals (ACQUIRE, INSPECT, HASH, CAPTURE)
//  so their values appear in the parse tree for Phase 4 dispatch.
//
//  primitive accepts NAME plus all keyword terminals — this is necessary
//  because a keyword string (e.g. "disk") is a valid primitive name and
//  the lexer would otherwise assign it the wrong token type.

operation: command primitive "(" arglist? ")" _NL?

command: ACQUIRE | INSPECT | HASH | CAPTURE

primitive: NAME
         | MEMORY | NETWORK | SYSTEM | DISK
         | ACQUIRE | INSPECT | HASH | CAPTURE

// ─── Arguments ───────────────────────────────────────────────────────────────
//
//  pid=1044, size=4096, path="C:\suspect\invoice.pdf", state=running
//
//  arg_value accepts NAME plus all keyword terminals for the same reason
//  as primitive — an argument value might be a word that is also a keyword.

arglist: argument ("," argument)*

argument: arg_name "=" arg_value

arg_name: NAME

arg_value: STRING
         | INTEGER
         | NAME
         | MEMORY | NETWORK | SYSTEM | DISK
         | ACQUIRE | INSPECT | HASH | CAPTURE

// ─── Named keyword terminals ──────────────────────────────────────────────────
//
//  Defined as named terminals (not anonymous string literals) so they
//  survive into the parse tree. Lark gives string literals higher lexer
//  priority than the NAME regex, so no ambiguity arises at the token level.
//  The primitive and arg_value rules above handle positional ambiguity
//  at the grammar level.

// Section names
MEMORY  : "memory"
NETWORK : "network"
SYSTEM  : "system"
DISK    : "disk"

// Command keywords
ACQUIRE : "acquire"
INSPECT : "inspect"
HASH    : "hash"
CAPTURE : "capture"

// ─── Core terminals ───────────────────────────────────────────────────────────

// Double-quoted string — no escape sequences in v0.1.
// Backslashes are treated as literal characters (Windows paths work correctly).
STRING  : "\"" /[^"]*/ "\""

// Unsigned integer literal.
INTEGER : /[0-9]+/

// Unquoted identifier: starts with letter or underscore,
// followed by letters, digits, or underscores.
// All named keyword terminals above have higher lexer priority than NAME
// because Lark gives string literals priority over regex terminals.
NAME    : /[a-zA-Z_][a-zA-Z0-9_]*/

// ─── Whitespace and structure ─────────────────────────────────────────────────

// _NL matches one or more physical newlines (with optional blank-line whitespace).
// Leading underscore tells Lark to discard these tokens from the parse tree —
// they are structural only.
_NL : /(\r?\n[\t ]*)+/

// _INDENT and _DEDENT are virtual tokens injected by the JockyIndenter
// post-lexer in parser.py. Declared here so the grammar can reference them.
%declare _INDENT _DEDENT

// Ignore inline whitespace (spaces and tabs between tokens on the same line).
// The JockyIndenter processes leading whitespace into _INDENT/_DEDENT
// before this rule fires — do not remove this line.
%ignore /[ \t]+/

// Comments: # to end of line, discarded entirely.
%ignore /\#[^\n]*/