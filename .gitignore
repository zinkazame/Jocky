# JOCKY Forensic Intelligence Framework -- .gitignore
# ══════════════════════════════════════════
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
