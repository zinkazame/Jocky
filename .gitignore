# ── Compiled binaries (build locally, never commit) ──────────────────────────
*.exe
*.sys
*.obj
*.dll
*.pdb
*.ilk
*.exp
*.lib

# ── LLVM IR / build artefacts ────────────────────────────────────────────────
*.ll
*.bc
language/grammar/example_scripts/build/

# ── Vulnerable driver blobs (BYOVD) ──────────────────────────────────────────
# Drivers live inside byovd/kernel_subverter/ -- never at project root.
# The .sys pattern above covers them; these are belt-and-suspenders entries
# for the specific filenames that ended up at root by mistake.
/RTCore64.sys
/WinRing0x64.sys
/AsrDrv107.sys
/DBUtil_2_3.sys
/BS_LED64.sys
/signed.sys
*.bin

# ── Misplaced BYOVD source files (belong in byovd/kernel_subverter/) ─────────
/backend_winring0x64.c
/byovd.h
/check_exports.c
/check_exports.exe
/parse_minidump.ps1

