*_sweep.exe

# ── COMPLETELY UNRELATED FILES ────────────────────────────────────────────────
# CS2 game cheat — no comment needed
/cs2cheat.c

# MSI Afterburner — GPU OC tool used during kernel layout probing; not JOCKY
/MSIAfterburnerSetup*.exe
/afterburner_extracted/
/ab_zip/

# LibreHardwareMonitor — hardware sensor lib; BYOVD dev dependency, not project code
/LibreHardwareMonitor.zip
/lhm_extracted/

# OpenHardwareMonitor — same category
/ohm.zip
/ohm_extracted/

